{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "app-setting": ["./src/app-setting.ts"],
      "layouts/*": ["./src/layouts/*"],
      "modules/*": ["./src/modules/*"],
      "shared/*": ["./src/shared/*"],
      "store": ["./src/store"],
      "store/*": ["./src/store/*"]
    }
  },
  "include": ["src"]
}
